<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- BenchmarkDotNet refuses to run a non-optimized build; keep this honest. -->
    <Optimize>true</Optimize>
    <!--
      GC mode is declared PER JOB in BenchConfig (Workstation = what PgProj.Cli ships), NOT baked into
      the host process here. Server GC in the host silently degrades [MemoryDiagnoser]'s bytes/op
      accounting and measures a runtime the CLI never runs. See BenchConfig.cs and the audit (F1).
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PgProj.Core\PgProj.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
