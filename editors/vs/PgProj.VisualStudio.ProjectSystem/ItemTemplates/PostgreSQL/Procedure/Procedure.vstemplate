<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Procedure (PostgreSQL)</Name>
    <Description>A CREATE PROCEDURE script (plpgsql). Name it schema.procedure and keep it in that schema's folder.</Description>
    <ProjectType>PgProj</ProjectType>
    <TemplateID>PgProj.Item.Procedure</TemplateID>
    <DefaultName>public.procedure1.sql</DefaultName>
    <SortOrder>50</SortOrder>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.sql">Procedure.sql</ProjectItem>
  </TemplateContent>
</VSTemplate>
