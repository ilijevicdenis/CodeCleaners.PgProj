<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>View (PostgreSQL)</Name>
    <Description>A CREATE VIEW script. Name it schema.view (e.g. app.customer_orders) and keep it in that schema's folder.</Description>
    <ProjectType>PgProj</ProjectType>
    <TemplateID>PgProj.Item.View</TemplateID>
    <DefaultName>public.view1.sql</DefaultName>
    <SortOrder>30</SortOrder>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.sql">View.sql</ProjectItem>
  </TemplateContent>
</VSTemplate>
