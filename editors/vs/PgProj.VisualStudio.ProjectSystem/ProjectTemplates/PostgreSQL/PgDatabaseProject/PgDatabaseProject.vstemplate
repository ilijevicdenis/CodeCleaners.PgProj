<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>PostgreSQL Database Project</Name>
    <Description>An empty PostgreSQL database project (.pgproj). Declare objects as CREATE statements in .sql files, grouped in one folder per schema; Build produces a model and a .pgpkg package, Publish deploys incrementally to a server.</Description>
    <ProjectType>PgProj</ProjectType>
    <TemplateID>PgProj.DatabaseProject</TemplateID>
    <SortOrder>100</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>PgDatabase</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>SQL</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <PlatformTag>Linux</PlatformTag>
    <ProjectTypeTag>Database</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project File="Database.pgproj" TargetFileName="$safeprojectname$.pgproj" ReplaceParameters="true" />
  </TemplateContent>
</VSTemplate>
