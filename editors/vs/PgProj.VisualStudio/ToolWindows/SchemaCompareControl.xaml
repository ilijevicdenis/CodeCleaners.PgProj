<!-- EP-VS #25 Route B (modern). Remote UI data template for the Schema Compare tool window.
     This is a SERIALIZED data template (embedded resource), not compiled WPF — keep it to the
     Remote UI supported surface (layout panels, TextBlock, ListView, bindings). -->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{Binding Summary}"
               FontWeight="Bold"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <ListView Grid.Row="1" ItemsSource="{Binding Changes}">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Marker}" Width="20" />
            <TextBlock Text="{Binding ObjectType}" Width="180" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</DataTemplate>
