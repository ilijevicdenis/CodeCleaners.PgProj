<!-- EP-VS #25 Route B (modern) + #116. Remote UI data template for the interactive Schema Compare
     tool window: source/target pickers, action buttons, and a checkable diff. This is a SERIALIZED
     data template (embedded resource), not compiled WPF — keep it to the Remote UI supported
     surface (layout panels, TextBlock/TextBox/CheckBox/Button, ListView, bindings). -->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Source / target pickers: each a .pgproj, .pgpkg, .schema.snapshot, or a connection string. -->
    <Grid Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Source:" Width="56" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding SourceSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="A .pgproj, .pgpkg, .schema.snapshot, or a PostgreSQL connection string (the desired state)." />
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Target:" Width="56" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding TargetSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="A .pgproj, .pgpkg, .schema.snapshot, or a PostgreSQL connection string (the state to update)." />
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
      <Button Content="Compare" Command="{Binding CompareCommand}" Padding="10,2" Margin="0,0,6,0" />
      <Button Content="Include All" Command="{Binding IncludeAllCommand}" Padding="10,2" Margin="0,0,6,0" />
      <Button Content="Exclude All" Command="{Binding ExcludeAllCommand}" Padding="10,2" Margin="0,0,6,0" />
      <Button Content="Generate Script" Command="{Binding GenerateScriptCommand}" Padding="10,2" Margin="0,0,6,0" />
      <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="10,2" />
    </StackPanel>

    <TextBlock Grid.Row="3"
               Text="{Binding Summary}"
               FontWeight="Bold"
               TextWrapping="Wrap"
               Margin="0,0,0,6" />

    <ListView Grid.Row="4" ItemsSource="{Binding Changes}">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Marker}" Width="16" />
            <TextBlock Text="{Binding ObjectType}" Width="120" />
            <TextBlock Text="{Binding Risk}" Width="90" Opacity="0.8" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</DataTemplate>
