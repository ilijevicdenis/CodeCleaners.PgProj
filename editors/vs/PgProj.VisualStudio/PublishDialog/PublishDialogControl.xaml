<!-- EP-VS #115. Remote UI data template for the Publish dialog (embedded resource, serialized
     data template, NOT compiled WPF — keep to the Remote UI supported surface). The OK/Cancel
     buttons come from ShowDialogAsync's DialogOption; this template is only the body. -->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="12" MinWidth="520">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Text="{Binding ProjectName}" FontWeight="Bold" Margin="0,0,0,10" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Target connection:" VerticalAlignment="Center" Margin="0,0,8,6" />
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Publish profile:" VerticalAlignment="Center" Margin="0,0,8,6" />
    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProfilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Optional .pgpublish.json with options + SQLCMD variables. The connection string is never stored in it." Margin="0,0,0,6" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="SQLCMD variables:" VerticalAlignment="Center" Margin="0,0,8,6" />
    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Variables, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Name=Value;Name2=Value2 — overrides beat the profile, the profile beats the project defaults." Margin="0,0,0,10" />

    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding AllowDrops, Mode=TwoWay}"
              Content="Allow destructive changes (drop objects not in the project)" Margin="0,0,0,4" />
    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding NoTransaction, Mode=TwoWay}"
              Content="Do not wrap the deploy script in a transaction" Margin="0,0,0,4" />
    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding GenerateScriptOnly, Mode=TwoWay}"
              Content="Generate the deploy script only (do not execute)" Margin="0,0,0,4" />
    <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding RememberConnection, Mode=TwoWay}"
              Content="Remember this connection for this project (encrypted, current user only)" Margin="0,0,0,8" />

    <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Opacity="0.7"
               Text="The connection string is never written to the project or the profile. Remembering stores it DPAPI-encrypted under your Windows profile (%APPDATA%\pgproj) for prefill next time." />
  </Grid>
</DataTemplate>
