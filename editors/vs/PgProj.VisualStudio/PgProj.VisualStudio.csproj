<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================================
    PgProj Visual Studio extension (VSIX) — EP-VS #25 Route B, MODERN model.

    Rebuilt on **VisualStudio.Extensibility** (the out-of-process model) targeting **.NET 10**,
    for **Visual Studio 2026 and newer**. This replaces the previous classic-VSSDK /
    .NET Framework 4.7.2 scaffold (AsyncPackage, .vsct, OleMenuCommand, CPS project flavour).

    Scope (locked 2026-06-09): MODERN-ONLY. The custom `.pgproj` project system (Solution
    Explorer object tree + property pages) is intentionally DROPPED — the out-of-process model
    has no API to author a new project type (that still needs the in-proc VSSDK/CPS). Instead we
    lean on Route A (`PgProj.Sdk`), which already makes `.pgproj` an Open/Build/Publish citizen
    via Visual Studio's generic SDK-style project support. This extension adds: Publish & Schema
    Compare commands, a Schema Compare tool window, and `.sql` IntelliSense via an LSP provider —
    all delegating to the existing `pgproj` engine.

    BUILD: `dotnet build` packages the .vsix HEADLESS — the Microsoft.VisualStudio.Extensibility.Build
    NuGet package brings the VSIX build targets, so no VS install is needed to compile/package. Only
    F5-debugging into the experimental instance needs VS 2026 + the "Visual Studio extension development"
    workload. Still deliberately NOT in PgProj.slnx and NOT in `dotnet test` — it has its own solution
    (PgProj.VisualStudio.slnx).
    ============================================================================================
  -->

  <PropertyGroup>
    <!-- VS 2026 ships .NET 10 (LTS) as an extension host runtime; -windows is required for the
         Remote UI tool window. See PgProjExtension.cs for the DotnetTargetVersions declaration
         and the note on VSExtensibility issue #544 (early-VS2026 net10 selection bug). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PgProj.VisualStudio</RootNamespace>
    <AssemblyName>PgProj.VisualStudio</AssemblyName>
    <!-- The Language Server Provider and Output Window APIs are still marked [Experimental] in the
         VisualStudio.Extensibility SDK; opt in to using them (they emit build errors otherwise). -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_LSP;VSEXTPREVIEW_OUTPUTWINDOW</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Meta-package: the VisualStudio.Extensibility runtime API surface. -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <!-- Build targets that package the project into a .vsix and run the contribution analyzers. -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine, linked IN-PROCESS (no `pgproj` subprocess). The extension calls PgProj.Core for
         compare/publish and hosts PgProj.Lsp's LspServer over an in-memory pipe for `.sql` IntelliSense.
         These projects are net10 libraries; Npgsql flows in transitively and is packaged into the VSIX.
         Referencing them does NOT add this VSIX to PgProj.slnx or `dotnet test` — the gates are unaffected. -->
    <ProjectReference Include="..\..\..\src\PgProj.Core\PgProj.Core.csproj" />
    <ProjectReference Include="..\..\..\src\PgProj.Lsp\PgProj.Lsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remote UI control markup is a serialized data template embedded into the assembly — it is
         NOT compiled WPF (UseWpf is intentionally OFF). Mark it as an embedded resource. -->
    <EmbeddedResource Include="ToolWindows\SchemaCompareControl.xaml" />
    <EmbeddedResource Include="PublishDialog\PublishDialogControl.xaml" />
  </ItemGroup>

</Project>
