<Project Sdk="PgProj.Sdk/0.1.0">
  <PropertyGroup>
    <Name>PgProjProject</Name>
    <DefaultSchema>PGPROJ_DEFAULT_SCHEMA</DefaultSchema>
    <TargetPostgresVersion>PGPROJ_TARGET_VERSION</TargetPostgresVersion>
  </PropertyGroup>
  <!-- All *.sql files in this folder are included automatically.
       Add <EnableDefaultSqlItems>false</EnableDefaultSqlItems> to the PropertyGroup above
       to manage <Build Include="..." /> entries yourself. -->
</Project>
