{
  "$schema": "http://json.schemastore.org/template",
  "author": "CodeCleaners d.o.o.",
  "classifications": [ "Database", "PostgreSQL", "PgProj" ],
  "identity": "CodeCleaners.PgProj.Project",
  "name": "PgProj database project (empty)",
  "shortName": "pgproj",
  "tags": {
    "language": "SQL",
    "type": "project"
  },
  "sourceName": "PgProjProject",
  "preferNameDirectory": true,
  "symbols": {
    "DefaultSchema": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "public",
      "replaces": "PGPROJ_DEFAULT_SCHEMA",
      "description": "The project's default schema."
    },
    "TargetVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "18",
      "replaces": "PGPROJ_TARGET_VERSION",
      "description": "Target PostgreSQL major version."
    }
  }
}
