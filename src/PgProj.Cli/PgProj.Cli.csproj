<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PgProj.Core\PgProj.Core.csproj" />
    <ProjectReference Include="..\PgProj.Lsp\PgProj.Lsp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Server GC (non-concurrent) — measured 1.85x faster on a 258k-object build (4.82s->2.62s)
         vs the workstation default; the build is allocation-bound (dtrace: kernel time dominated by
         demand-zero page faults servicing GC heap commits — tools/profiling/PROFILING_PLAN.md Tier 3).
         Cost on a small interactive build is ~6 ms (imperceptible). Non-concurrent: this is a batch
         job, so background GC only adds overhead. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- Startup tax (dotnet-trace audit, 2026-06-07): GetLocaleInfoCore (culture init) + JIT/static-init.
         InvariantGlobalization removes culture/locale loading — safe here because the engine is already
         culture-invariant (OrdinalIgnoreCase comparisons, ToLowerInvariant / InvariantCulture throughout);
         CLI model output is byte-identical (checksum verified before/after). PublishReadyToRun precompiles
         to native so the runtime JITs far less at startup (pure codegen-ahead, no behaviour change; applies
         on `dotnet publish`). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- R2R only when a RID is set: it requires one, and a `dotnet tool` package is RID-agnostic IL,
         so an unconditional `true` breaks `dotnet pack` (PackAsTool publish has no RID → NETSDK1095).
         Nothing is lost — the SDK's CLI publish already passes PublishReadyToRun=false, and a plain
         `dotnet publish` without a RID can't R2R anyway; deployment publishes that set a RID still get it. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Ship the CLI as a .NET tool:  `dotnet tool install -g PgProj.Cli`  exposes the `pgproj` command.
    This is the standalone CLI distribution for scripting/CI; the PgProj.Sdk NuGet bundles the same
    CLI under tools/ for MSBuild, but this makes `pgproj` runnable on its own. `dotnet pack` produces
    the tool package (PgProj.Cli.<Version>.nupkg); it is not produced by `dotnet build`/`dotnet test`.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pgproj</ToolCommandName>
    <PackageId>PgProj.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>CodeCleaners d.o.o.</Authors>
    <Description>pgproj — PostgreSQL declarative database project CLI: build a .pgproj to a model/.pgpkg, compare schemas, and publish (deploy) to a server. Same engine as the PgProj.Sdk MSBuild SDK and the Visual Studio / VS Code extensions.</Description>
    <PackageTags>postgresql;pgproj;database;ssdt;schema-compare;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/ilijevicdenis/CodeCleaners.PgProj</PackageProjectUrl>
  </PropertyGroup>

</Project>
