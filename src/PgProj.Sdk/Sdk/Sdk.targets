<!--
  PgProj MSBuild SDK - targets.

  Pulls the common MSBuild targets (Build/Clean/Rebuild/Restore + the IDE design-time targets) via
  Microsoft.Build.NoTargets, then layers the pgproj CLI on top: a real Build runs `pgproj build`, and
  Publish runs the deploy engine. NoTargets compiles nothing, so the database project loads in Visual
  Studio AND participates in `dotnet build` / solution build / right-click Publish.
-->
<Project>
  <!--
    Resolve a single CLI command line. Precedence:
      1. PgProjCliExe      - a `pgproj`/`pgproj.exe` on PATH or a full path (no `dotnet` prefix).
      2. PgProjCliDll      - a packaged framework-dependent publish (tools/PgProj.Cli.dll): `dotnet <dll>`.
      3. PgProjCliProject  - from-source CLI .csproj, run via `dotnet run` with a trailing arg separator.
  -->
  <PropertyGroup>
    <_PgProjCliInvocation Condition="'$(PgProjCliExe)' != ''">&quot;$(PgProjCliExe)&quot;</_PgProjCliInvocation>
    <_PgProjCliInvocation Condition="'$(_PgProjCliInvocation)' == '' And '$(PgProjCliDll)' != ''">dotnet &quot;$(PgProjCliDll)&quot;</_PgProjCliInvocation>
    <_PgProjCliInvocation Condition="'$(_PgProjCliInvocation)' == '' And '$(PgProjCliProject)' != ''">dotnet run --project &quot;$(PgProjCliProject)&quot; -c $(Configuration) --</_PgProjCliInvocation>
  </PropertyGroup>

  <Target Name="_PgProjResolveCli">
    <Error Condition="'$(_PgProjCliInvocation)' == ''"
           Text="PgProj.Sdk could not locate the pgproj CLI. Set one of: PgProjCliExe (a 'pgproj' on PATH), PgProjCliDll (a published PgProj.Cli.dll), or PgProjCliProject (the CLI .csproj when building from source). A packaged SDK ships tools/PgProj.Cli.dll; from source the CLI is auto-detected next to the SDK." />
  </Target>

  <!-- Deploy/preview script naming + publish argument assembly (used by the Publish target below). The
       script is named with a leading '_' so the CLI's source globber (which skips '_'-prefixed files)
       never re-parses it as a schema source on the next build. -->
  <PropertyGroup>
    <PgProjPublishScript Condition="'$(PgProjPublishScript)' == ''">$(PgProjOutputDir)\_$(MSBuildProjectName).deploy.sql</PgProjPublishScript>
    <_PgProjOfflineDryRun Condition="'$(PgProjPublishDryRun)' == 'true' And '$(PgProjPublishConnection)' == ''">true</_PgProjOfflineDryRun>
    <_PgProjPublishArgs Condition="'$(_PgProjOfflineDryRun)' == 'true'">script &quot;$(MSBuildProjectFullPath)&quot; -o &quot;$(PgProjPublishScript)&quot;</_PgProjPublishArgs>
    <_PgProjPublishArgs Condition="'$(_PgProjOfflineDryRun)' != 'true'">publish &quot;$(MSBuildProjectFullPath)&quot;</_PgProjPublishArgs>
    <_PgProjPublishArgs Condition="'$(_PgProjOfflineDryRun)' != 'true' And '$(PgProjPublishConnection)' != ''">$(_PgProjPublishArgs) --connection &quot;$(PgProjPublishConnection)&quot;</_PgProjPublishArgs>
    <_PgProjPublishArgs Condition="'$(_PgProjOfflineDryRun)' != 'true' And '$(PgProjPublishDryRun)' == 'true'">$(_PgProjPublishArgs) --dry-run -o &quot;$(PgProjPublishScript)&quot;</_PgProjPublishArgs>
    <_PgProjPublishArgs Condition="'$(PgProjPublishProfile)' != ''">$(_PgProjPublishArgs) --profile &quot;$(PgProjPublishProfile)&quot;</_PgProjPublishArgs>
    <_PgProjPublishArgs Condition="'$(_PgProjOfflineDryRun)' != 'true' And '$(PgProjPublishAllowDrops)' == 'true'">$(_PgProjPublishArgs) --allow-drops</_PgProjPublishArgs>
    <_PgProjPublishArgs Condition="'$(PgProjPublishExtraArgs)' != ''">$(_PgProjPublishArgs) $(PgProjPublishExtraArgs)</_PgProjPublishArgs>
  </PropertyGroup>

  <!-- The common MSBuild targets (provides Build/Clean/Rebuild/Restore + the IDE design-time targets
       VS calls on load). NoTargets has no CoreCompile, so nothing is compiled. -->
  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" Version="3.7.134" />

  <!--
    Run the pgproj CLI build as part of a REAL Build (Ctrl+Shift+B / `dotnet build`), emitting the
    model (.model.json) + portable package (.pgpkg). AfterTargets="Build" means it does NOT run during
    the IDE's frequent design-time builds (those call the design-time targets, not Build), so editing
    stays responsive. Inputs/Outputs give incremental skip when no .sql changed.
  -->
  <Target Name="_PgProjBuild" AfterTargets="Build" DependsOnTargets="_PgProjResolveCli"
          Inputs="@(Build);$(MSBuildProjectFullPath)" Outputs="$(PgProjOutput);$(PgProjPackage)">
    <Message Importance="high" Text="pgproj: building database project '$(MSBuildProjectName)'" />
    <MakeDir Directories="$(PgProjOutputDir)" />
    <Exec Command="$(_PgProjCliInvocation) build &quot;$(MSBuildProjectFullPath)&quot; -o &quot;$(PgProjOutput)&quot; --package &quot;$(PgProjPackage)&quot;" />
  </Target>

  <!--
    EP-REF #147: contribute the built .pgpkg to the NuGet package under pgpkg/<Name>.pgpkg. NuGet's pack
    invokes the targets listed in TargetsForTfmSpecificContentInPackage (wired in Sdk.props); DependsOn the
    pgproj build so the .pgpkg exists by the time pack collects content. `dotnet pack` therefore yields a
    <Name>.<Version>.nupkg whose only payload is the portable package — consumed as a PackageReference (#148).
  -->
  <Target Name="_PgProjPackPackage" DependsOnTargets="Build">
    <Error Condition="!Exists('$(PgProjPackage)')"
           Text="pgproj pack: the built package '$(PgProjPackage)' was not produced — the database build must succeed before pack." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(PgProjPackage)">
        <PackagePath>$(PgProjPackageFolder)/$(MSBuildProjectName).pgpkg</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <!-- Remove the pgproj outputs when the project is cleaned (alongside Common's Clean). -->
  <Target Name="_PgProjClean" AfterTargets="Clean">
    <Delete Files="$(PgProjOutput)" Condition="Exists('$(PgProjOutput)')" />
    <Delete Files="$(PgProjPackage)" Condition="Exists('$(PgProjPackage)')" />
  </Target>

  <!--
    Publish: right-click Publish in VS (or `dotnet build -t:Publish`). Builds first, then runs the
    deploy engine. Defined AFTER the NoTargets import so it overrides Common.targets' (ClickOnce/web)
    Publish target. Shapes:
      * Real publish    (PgProjPublishConnection set, no dry run): diff vs the live server + apply.
      * Diff dry-run    (connection + PgProjPublishDryRun=true): write the incremental deploy script.
      * Offline dry-run (no connection + PgProjPublishDryRun=true): write the full create script.
    With neither a connection nor a dry run, it fails with a clear message instead of a silent no-op.
  -->
  <Target Name="Publish" DependsOnTargets="_PgProjResolveCli;Build">
    <Error Condition="'$(PgProjPublishConnection)' == '' And '$(PgProjPublishDryRun)' != 'true'"
           Text="pgproj Publish needs a target: set &lt;PgProjPublishConnection&gt; in the .pgproj (or pass -p:PgProjPublishConnection=...), or do a dry run with -p:PgProjPublishDryRun=true (offline create-script preview, no server needed). A publish profile alone (PgProjPublishProfile) does not carry the connection string - that is supplied here or via PGPROJ_CONNECTION." />
    <!-- SQLCMD variable overrides (the SQLCMD Variables property page / PgProjPublishVariables):
         semicolon-separated Name=Value pairs become repeated var flags. Computed inside the target
         because item expansion is not available while static properties evaluate. -->
    <ItemGroup Condition="'$(PgProjPublishVariables)' != ''">
      <_PgProjPublishVar Include="$(PgProjPublishVariables)" />
    </ItemGroup>
    <PropertyGroup>
      <_PgProjVarArgs Condition="'$(PgProjPublishVariables)' != ''">@(_PgProjPublishVar->'--var &quot;%(Identity)&quot;', ' ')</_PgProjVarArgs>
    </PropertyGroup>
    <Message Importance="high" Text="pgproj: publishing database project '$(MSBuildProjectName)' (offline create-script preview)" Condition="'$(_PgProjOfflineDryRun)' == 'true'" />
    <Message Importance="high" Text="pgproj: publishing database project '$(MSBuildProjectName)'" Condition="'$(_PgProjOfflineDryRun)' != 'true'" />
    <Exec Command="$(_PgProjCliInvocation) $(_PgProjPublishArgs) $(_PgProjVarArgs)" />
  </Target>
</Project>
