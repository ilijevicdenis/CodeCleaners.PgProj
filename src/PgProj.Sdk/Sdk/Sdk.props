<!--
  PgProj MSBuild SDK - props.

  Composed on Microsoft.Build.NoTargets so a .pgproj imports the common MSBuild infrastructure
  (Microsoft.Common.props/.targets) and therefore LOADS in the Visual Studio project system - while
  Build/Publish still route to the pgproj CLI (see Sdk.targets). Without the common imports VS
  reports "the project is missing some critical imports or the referenced SDK cannot be found" and
  refuses to load it; `dotnet build` works regardless because it only needs our Build target, but the
  IDE requires the full project-system contract that Microsoft.Common provides.
-->
<Project>
  <PropertyGroup>
    <!-- NoTargets/Common.props read these, so set them BEFORE importing NoTargets (below). A database
         project compiles nothing, but the project system still needs a TargetFramework to evaluate;
         netstandard2.0 is inert here - NoTargets resolves no framework references. -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.0</TargetFramework>
    <!-- No implicit compile-item globbing: the only items are our <Build> .sql sources. -->
    <EnableDefaultItems Condition="'$(EnableDefaultItems)' == ''">false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- A database project has no assembly/refs; keep NoTargets from adding framework reference items. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoWarn>$(NoWarn);NU1604</NoWarn>
  </PropertyGroup>

  <!-- The common MSBuild infrastructure (the piece the IDE requires). Imported before our own items
       and the properties that depend on Common-provided values (e.g. output paths). -->
  <Import Project="Sdk.props" Sdk="Microsoft.Build.NoTargets" Version="3.7.134" />

  <PropertyGroup>
    <!--
      How the pgproj CLI is invoked (resolved in Sdk.targets). Two modes:
        1. From-source (this repo): PgProjCliProject points at the CLI .csproj, run with `dotnet run`.
        2. Packaged SDK (NuGet): the .nupkg carries a framework-dependent CLI under tools/; run as
           `dotnet <tools>/PgProj.Cli.dll`. PgProjCliDll points at it.
      Override either property to force a specific invocation (e.g. a self-built CLI).
    -->
    <_PgProjCliSourceCandidate>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\PgProj.Cli\PgProj.Cli.csproj'))</_PgProjCliSourceCandidate>
    <_PgProjCliDllCandidate>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\tools\PgProj.Cli.dll'))</_PgProjCliDllCandidate>
    <PgProjCliDll Condition="'$(PgProjCliDll)' == '' And Exists('$(_PgProjCliDllCandidate)')">$(_PgProjCliDllCandidate)</PgProjCliDll>
    <PgProjCliProject Condition="'$(PgProjCliProject)' == '' And '$(PgProjCliDll)' == '' And Exists('$(_PgProjCliSourceCandidate)')">$(_PgProjCliSourceCandidate)</PgProjCliProject>

    <!-- Build artifacts. The JSON model is the .dacpac analogue; the .pgpkg is the portable package. -->
    <PgProjOutputDir Condition="'$(PgProjOutputDir)' == ''">$(MSBuildProjectDirectory)\bin</PgProjOutputDir>
    <PgProjOutput Condition="'$(PgProjOutput)' == ''">$(PgProjOutputDir)\$(MSBuildProjectName).model.json</PgProjOutput>
    <PgProjPackage Condition="'$(PgProjPackage)' == ''">$(PgProjOutputDir)\$(MSBuildProjectName).pgpkg</PgProjPackage>

    <DefaultLanguageSourceExtension>.sql</DefaultLanguageSourceExtension>

    <!--
      Publish settings (surfaced to VS's right-click Publish), set in the .pgproj or on the command
      line (-p:PgProjPublishConnection=...):
        PgProjPublishConnection  the Npgsql connection string to deploy to (required for Publish)
        PgProjPublishProfile     a .pgpublish.json profile (options + SQLCMD variables)
        PgProjPublishAllowDrops  true allows destructive changes
        PgProjPublishExtraArgs   extra `pgproj publish` flags (e.g. the no-transaction switch)
      Never hard-code a connection string in a committed .pgproj - prefer a profile or pass at build time.
    -->
    <PgProjPublishAllowDrops Condition="'$(PgProjPublishAllowDrops)' == ''">false</PgProjPublishAllowDrops>

    <!-- Opt out of the default .sql glob with EnableDefaultSqlItems=false to manage <Build> yourself. -->
    <EnableDefaultSqlItems Condition="'$(EnableDefaultSqlItems)' == ''">true</EnableDefaultSqlItems>
  </PropertyGroup>

  <!--
    Default glob: auto-include every **.sql when EnableDefaultSqlItems is true. If the user also
    declares <Build Include="**/*.sql" /> the resolved identities dedupe. bin/obj are excluded.
  -->
  <ItemGroup Condition="'$(EnableDefaultSqlItems)' == 'true'">
    <Build Include="**/*.sql" Exclude="bin/**/*.sql;obj/**/*.sql" />
  </ItemGroup>

  <!--
    Visual Studio project-system support:
      * ProjectCapability "PgProj" identifies a database project to CPS - the project-system extension
        keys its MEF AppliesTo exports and the SolutionHasProjectCapability:PgProj UIContext on it.
      * The items schema teaches Solution Explorer this SDK's vocabulary (Build = .sql source).
      * The four Project-Properties pages (EP-VS #114): Database Settings, Target Platform,
        Build Output, SQLCMD Variables - CPS generic rules persisting into this .pgproj.
        Command-line MSBuild ignores all of these.
  -->
  <ItemGroup>
    <ProjectCapability Include="PgProj" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\ProjectItemsSchema.xaml" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\DatabaseSettingsPage.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\TargetPlatformPage.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\BuildOutputPage.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\SqlCmdVariablesPage.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
  </ItemGroup>
</Project>
