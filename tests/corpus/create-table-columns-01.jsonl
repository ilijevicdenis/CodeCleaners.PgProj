{"id":"ctcola0146","category":"create-table-columns","sql":"CREATE TABLE s.tc146 (a integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY, b text NOT NULL, c numeric(10,2) DEFAULT 0)","expect":"ok","ref":"sql-createtable","note":"identity PK with other columns"}
{"id":"ctcola0147","category":"create-table-columns","sql":"CREATE TABLE s.tc147 (a text COLLATE \"C\" NOT NULL DEFAULT 'x')","expect":"ok","ref":"sql-createtable","note":"COLLATE, NOT NULL, DEFAULT all together"}
{"id":"ctcola0148","category":"create-table-columns","sql":"CREATE TABLE s.tc148 (a text STORAGE EXTENDED COMPRESSION pglz COLLATE \"C\" NOT NULL DEFAULT 'x')","expect":"ok","ref":"sql-createtable","note":"STORAGE + COMPRESSION + COLLATE + NOT NULL + DEFAULT"}
{"id":"ctcola0149","category":"create-table-columns","sql":"CREATE TABLE s.tc149 (x integer, y integer GENERATED ALWAYS AS (x * 2) STORED NOT NULL)","expect":"ok","ref":"sql-createtable","note":"generated column with NOT NULL"}
{"id":"ctcola0150","category":"create-table-columns","sql":"CREATE TABLE s.tc150 (a integer GENERATED ALWAYS AS IDENTITY (START WITH 100 INCREMENT BY 10 CACHE 5 CYCLE))","expect":"ok","ref":"sql-createtable","note":"IDENTITY with full sequence options"}
{"id":"ctcola0151","category":"create-table-columns","sql":"CREATE TABLE s.tc151 (a integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1))","expect":"ok","ref":"sql-createtable","note":"BY DEFAULT IDENTITY with sequence options"}
{"id":"ctcola0152","category":"create-table-columns","sql":"CREATE TABLE s.tc152 (\"my col\" integer)","expect":"ok","ref":"sql-createtable","note":"quoted column name with space"}
{"id":"ctcola0153","category":"create-table-columns","sql":"CREATE TABLE s.tc153 (\"SELECT\" integer)","expect":"ok","ref":"sql-createtable","note":"quoted reserved keyword as column name"}
{"id":"ctcola0154","category":"create-table-columns","sql":"CREATE TABLE s.tc154 (a integer CONSTRAINT pk PRIMARY KEY CONSTRAINT chk CHECK (a > 0))","expect":"ok","ref":"sql-createtable","note":"multiple named constraints on one column"}
{"id":"ctcola0155","category":"create-table-columns","sql":"CREATE TABLE s.tc155 (a integer CHECK (a > 0) ENFORCED)","expect":"ok","ref":"sql-createtable","note":"CHECK constraint with ENFORCED attribute (PG18)"}
{"id":"ctcola0156","category":"create-table-columns","sql":"CREATE TABLE s.tc156 (a integer CHECK (a > 0) NOT ENFORCED)","expect":"ok","ref":"sql-createtable","note":"CHECK constraint NOT ENFORCED (PG18)"}
{"id":"ctcola0157","category":"create-table-columns","sql":"CREATE TABLE s.tc157 (a integer GENERATED ALWAYS AS (1+1) STORED, b text DEFAULT 'y', c boolean NOT NULL)","expect":"ok","ref":"sql-createtable","note":"mix of generated, default, not-null columns"}
{"id":"ctcola0158","category":"create-table-columns","sql":"CREATE TABLE (a integer)","expect":"error","ref":"sql-createtable","note":"syntax error: missing table name"}
{"id":"ctcola0159","category":"create-table-columns","sql":"CREATE TABLE s.tc_err1 (a)","expect":"error","ref":"sql-createtable","note":"syntax error: column missing data type"}
{"id":"ctcola0160","category":"create-table-columns","sql":"CREATE TABLE s.tc_err2 (a integer,)","expect":"error","ref":"sql-createtable","note":"syntax error: trailing comma in column list"}
{"id":"ctcola0161","category":"create-table-columns","sql":"CREATE TABLE s.tc_err3 (a numeric(10,2,1))","expect":"error","ref":"sql-createtable","note":"error: too many modifiers for numeric"}
{"id":"ctcola0162","category":"create-table-columns","sql":"CREATE TABLE s.tc_err4 (a varchar(-1))","expect":"error","ref":"sql-createtable","note":"error: negative length for varchar"}
{"id":"ctcola0163","category":"create-table-columns","sql":"CREATE TABLE s.tc_err5 (a bit(0))","expect":"error","ref":"sql-createtable","note":"error: zero length for bit type"}
{"id":"ctcola0164","category":"create-table-columns","sql":"CREATE TABLE s.tc_err6 (a integer NOT NULL NOT NULL)","expect":"ok","ref":"sql-createtable","note":"duplicate NOT NULL is accepted by PG18"}
{"id":"ctcola0165","category":"create-table-columns","sql":"CREATE TABLE s.tc_err7 (a integer DEFAULT 1 DEFAULT 2)","expect":"error","ref":"sql-createtable","note":"error: duplicate DEFAULT clause"}
{"id":"ctcola0166","category":"create-table-columns","sql":"CREATE TABLE s.tc_err8 (a integer GENERATED ALWAYS AS (1+1))","expect":"ok","ref":"sql-createtable","note":"GENERATED ALWAYS AS (expr) without STORED is valid in PG18 (VIRTUAL implied)"}
{"id":"ctcola0167","category":"create-table-columns","sql":"CREATE TABLE s.tc_err9 (a text COLLATE \"nonexistent_collation_xyz\")","expect":"error","ref":"sql-createtable","note":"error: nonexistent collation (semantic)"}
{"id":"ctcola0168","category":"create-table-columns","sql":"CREATE TABLE s.tc_err10 (a integer STORAGE INVALID_OPT)","expect":"error","ref":"sql-createtable","note":"error: invalid STORAGE option"}
{"id":"ctcola0169","category":"create-table-columns","sql":"CREATE TABLE s.tc_err11 (a integer DEFAULT nextval('s.seq') GENERATED ALWAYS AS IDENTITY)","expect":"error","ref":"sql-createtable","note":"error: DEFAULT and GENERATED IDENTITY conflict"}
{"id":"ctcola0170","category":"create-table-columns","sql":"CREATE TABLE s.tc_err12 (a integer GENERATED ALWAYS AS IDENTITY GENERATED BY DEFAULT AS IDENTITY)","expect":"error","ref":"sql-createtable","note":"error: duplicate GENERATED clause"}
