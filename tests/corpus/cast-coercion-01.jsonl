{"id":"cst2a0146","category":"cast-coercion","sql":"SELECT CAST('{\"a\":1}' AS jsonb) -> 'a'","expect":"ok","ref":"sql-expressions","note":"CAST to jsonb then use json operator"}
{"id":"cst2a0147","category":"cast-coercion","sql":"SELECT ('{\"a\":1}'::jsonb) ->> 'a'","expect":"ok","ref":"sql-expressions","note":":: cast to jsonb then text extraction operator"}
{"id":"cst2a0148","category":"cast-coercion","sql":"SELECT ARRAY[1::bigint, 2::bigint, 3::bigint]","expect":"ok","ref":"sql-expressions","note":"array constructor with :: cast elements"}
{"id":"cst2a0149","category":"cast-coercion","sql":"SELECT ARRAY[CAST(1 AS text), CAST(2 AS text)]","expect":"ok","ref":"sql-expressions","note":"array constructor with CAST elements"}
{"id":"cst2a0150","category":"cast-coercion","sql":"SELECT (ROW(1, 'test', '10.00'))::s.t2","expect":"error","ref":"sql-expressions","note":"cast ROW to table type — requires matching columns (semantic error for mismatched fields)"}
{"id":"cst2a0151","category":"cast-coercion","sql":"SELECT CAST(1 AS oid)","expect":"ok","ref":"sql-expressions","note":"CAST to oid type"}
{"id":"cst2a0152","category":"cast-coercion","sql":"SELECT 1::oid","expect":"ok","ref":"sql-expressions","note":":: cast to oid"}
{"id":"cst2a0153","category":"cast-coercion","sql":"SELECT 's.t'::regclass","expect":"ok","ref":"sql-expressions","note":":: cast schema-qualified text to regclass"}
{"id":"cst2a0154","category":"cast-coercion","sql":"SELECT CAST('s.f' AS regprocedure)","expect":"error","ref":"sql-expressions","note":"CAST to regprocedure requires argument types notation — semantic error"}
{"id":"cst2a0155","category":"cast-coercion","sql":"SELECT 's.f(integer)'::regprocedure","expect":"ok","ref":"sql-expressions","note":":: cast text with arg types to regprocedure"}
{"id":"cst2a0156","category":"cast-coercion","sql":"SELECT CAST('integer' AS regtype)","expect":"ok","ref":"sql-expressions","note":"CAST text to regtype"}
{"id":"cst2a0157","category":"cast-coercion","sql":"SELECT 'integer'::regtype","expect":"ok","ref":"sql-expressions","note":":: cast text to regtype"}
{"id":"cst2a0158","category":"cast-coercion","sql":"SELECT CAST(1 AS text) = CAST(1 AS text)","expect":"ok","ref":"sql-expressions","note":"equality of two CAST results"}
{"id":"cst2a0159","category":"cast-coercion","sql":"SELECT CAST(name AS text) IS NOT NULL FROM s.t","expect":"ok","ref":"sql-expressions","note":"CAST result in IS NOT NULL test"}
{"id":"cst2a0160","category":"cast-coercion","sql":"SELECT val::numeric(12,2) IS NULL FROM s.t","expect":"ok","ref":"sql-expressions","note":":: cast with typmod in IS NULL test"}
{"id":"cst2a0161","category":"cast-coercion","sql":"SELECT CAST(qty AS numeric) / CAST(10 AS numeric) FROM s.t","expect":"ok","ref":"sql-expressions","note":"division with CAST operands from table column"}
{"id":"cst2a0162","category":"cast-coercion","sql":"SELECT name::bytea FROM s.t","expect":"ok","ref":"sql-expressions","note":":: cast text column to bytea"}
{"id":"cst2a0163","category":"cast-coercion","sql":"SELECT CAST(42 AS bit(8))","expect":"ok","ref":"sql-expressions","note":"CAST integer to bit type with length typmod"}
{"id":"cst2a0164","category":"cast-coercion","sql":"SELECT 42::bit(8)","expect":"ok","ref":"sql-expressions","note":":: cast integer to bit(8)"}
{"id":"cst2a0165","category":"cast-coercion","sql":"SELECT CAST(B'1010' AS integer)","expect":"ok","ref":"sql-expressions","note":"CAST bit string literal to integer"}
{"id":"cst2a0166","category":"cast-coercion","sql":"SELECT B'1010'::integer","expect":"ok","ref":"sql-expressions","note":":: cast bit literal to integer"}
{"id":"cst2a0167","category":"cast-coercion","sql":"SELECT CAST(42.5 AS money)","expect":"ok","ref":"sql-expressions","note":"CAST numeric to money type"}
{"id":"cst2a0168","category":"cast-coercion","sql":"SELECT 42.5::money","expect":"ok","ref":"sql-expressions","note":":: cast numeric to money"}
{"id":"cst2a0169","category":"cast-coercion","sql":"SELECT CAST(42 AS CAST)","expect":"error","ref":"sql-expressions","note":"CAST using 'CAST' as type name — syntax error"}
{"id":"cst2a0170","category":"cast-coercion","sql":"SELECT CAST(integer AS text)","expect":"error","ref":"sql-expressions","note":"CAST with type name as expression, not a value — semantic error"}
