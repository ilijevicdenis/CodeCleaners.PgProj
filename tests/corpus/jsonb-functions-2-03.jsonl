{"id":"jsn2c0001","category":"jsonb-functions-2","sql":"SELECT jsonb_set(data, '{a}', '\"hello\"'::jsonb, true) FROM s.t","expect":"ok","ref":"functions-json","note":"jsonb_set: update path, create_if_missing=true"}
{"id":"jsn2c0002","category":"jsonb-functions-2","sql":"SELECT jsonb_set_lax(data, '{b}', NULL, true, 'use_json_null') FROM s.t","expect":"ok","ref":"functions-json","note":"jsonb_set_lax: null_value_treatment=use_json_null"}
{"id":"jsn2c0003","category":"jsonb-functions-2","sql":"SELECT jsonb_insert(data, '{arr,0}', '99'::jsonb, false) FROM s.t","expect":"ok","ref":"functions-json","note":"jsonb_insert: insert before=false (after), array path"}
{"id":"jsn2c0004","category":"jsonb-functions-2","sql":"SELECT jsonb_strip_nulls(data), jsonb_pretty(data) FROM s.t","expect":"ok","ref":"functions-json","note":"jsonb_strip_nulls and jsonb_pretty on fixture column"}
{"id":"jsn2c0005","category":"jsonb-functions-2","sql":"SELECT * FROM json_to_record('{\"a\":1,\"b\":\"hello\"}'::json) AS r(a int, b text)","expect":"ok","ref":"functions-json","note":"json_to_record: parse JSON object into typed record with column defs"}
{"id":"jsn2c0006","category":"jsonb-functions-2","sql":"SELECT * FROM jsonb_populate_recordset(NULL::s.t, '[{\"id\":1},{\"id\":2}]'::jsonb)","expect":"ok","ref":"functions-json","note":"jsonb_populate_recordset: expand jsonb array to typed rows"}
{"id":"jsn2c0007","category":"jsonb-functions-2","sql":"SELECT * FROM json_each('{\"x\":1,\"y\":2}'::json)","expect":"ok","ref":"functions-json","note":"json_each: expand JSON object to (key,value) rows"}
{"id":"jsn2c0008","category":"jsonb-functions-2","sql":"SELECT * FROM jsonb_each_text('{\"a\":\"foo\",\"b\":42}'::jsonb)","expect":"ok","ref":"functions-json","note":"jsonb_each_text: expand jsonb object to (key,value text) rows"}
{"id":"jsn2c0009","category":"jsonb-functions-2","sql":"SELECT jsonb_path_exists(data, '$.name ? (@ == \"Alice\")') FROM s.t","expect":"ok","ref":"functions-json","note":"jsonb_path_exists: filter expression in jsonpath"}
{"id":"jsn2c0010","category":"jsonb-functions-2","sql":"SELECT JSON_EXISTS(data, '$.id') FROM s.t","expect":"ok","ref":"functions-json","note":"SQL/JSON JSON_EXISTS on jsonb column"}
