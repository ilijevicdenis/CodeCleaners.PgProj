{"id":"xmla0141","category":"xml","sql":"SELECT xml_is_well_formed(NULL)","expect":"ok","ref":"functions-xml","note":"xml_is_well_formed with NULL returns NULL"}
{"id":"xmla0142","category":"xml","sql":"SELECT xmltext('hello & world')","expect":"ok","ref":"functions-xml","note":"xmltext with ampersand - escapes to entity"}
{"id":"xmla0143","category":"xml","sql":"SELECT xmltext('<b>bold</b>')","expect":"ok","ref":"functions-xml","note":"xmltext with angle brackets - escaped"}
{"id":"xmla0144","category":"xml","sql":"SELECT xmltext('')","expect":"ok","ref":"functions-xml","note":"xmltext with empty string"}
{"id":"xmla0145","category":"xml","sql":"SELECT xmltext(NULL)","expect":"ok","ref":"functions-xml","note":"xmltext with NULL returns NULL"}
{"id":"xmla0146","category":"xml","sql":"SELECT xmlelement(NAME foo, xmlattributes(id AS id), xmlforest(name AS n, val AS v)) FROM s.t LIMIT 1","expect":"ok","ref":"functions-xml","note":"xmlelement combining attributes and xmlforest content"}
{"id":"xmla0147","category":"xml","sql":"SELECT xmlconcat(xmlforest(1 AS a), xmlforest(2 AS b))","expect":"ok","ref":"functions-xml","note":"xmlconcat of xmlforest results"}
{"id":"xmla0148","category":"xml","sql":"SELECT xmlelement(NAME root, xmlcomment('comment'), xmlelement(NAME child, 'text'))","expect":"ok","ref":"functions-xml","note":"xmlelement with xmlcomment child"}
{"id":"xmla0149","category":"xml","sql":"SELECT xmlelement(NAME root, xmlpi(NAME target, 'data'), xmlelement(NAME body, 'x'))","expect":"ok","ref":"functions-xml","note":"xmlelement with xmlpi child"}
{"id":"xmla0150","category":"xml","sql":"SELECT xmlroot(xmlparse(DOCUMENT '<?xml version=\"1.0\"?><root/>'), VERSION '1.1', STANDALONE YES)","expect":"ok","ref":"functions-xml","note":"xmlroot overriding existing declaration"}
{"id":"xmla0151","category":"xml","sql":"SELECT xmlserialize(DOCUMENT xmlroot(xmlelement(NAME root), VERSION '1.0') AS text)","expect":"ok","ref":"functions-xml","note":"xmlserialize of xmlroot result"}
{"id":"xmla0152","category":"xml","sql":"SELECT (xpath('/root/child/text()', xmlparse(DOCUMENT '<root><child>hello</child></root>')))[1]","expect":"ok","ref":"functions-xml","note":"xpath result subscript access"}
{"id":"xmla0153","category":"xml","sql":"SELECT array_length(xpath('//item', xmlparse(DOCUMENT '<list><item/><item/><item/></list>')), 1)","expect":"ok","ref":"functions-xml","note":"xpath result count via array_length"}
{"id":"xmla0154","category":"xml","sql":"SELECT xmlelement(NAME r, id, name, val) FROM s.t ORDER BY id LIMIT 3","expect":"ok","ref":"functions-xml","note":"xmlelement in SELECT with ORDER BY and LIMIT"}
{"id":"xmla0155","category":"xml","sql":"SELECT xmlelement(NAME root, (SELECT xmlagg(xmlelement(NAME item, name)) FROM s.t))","expect":"ok","ref":"functions-xml","note":"xmlelement with subquery xmlagg content"}
{"id":"xmla0156","category":"xml","sql":"SELECT * FROM xmltable('/rows/row' PASSING xmlparse(DOCUMENT '<rows><row><a>1</a></row><row><a>2</a></row><row><a>3</a></row></rows>') COLUMNS rn FOR ORDINALITY, a int PATH 'a') WHERE a > 1","expect":"ok","ref":"functions-xml","note":"xmltable in FROM with WHERE filter"}
{"id":"xmla0157","category":"xml","sql":"SELECT x.rn, x.a FROM xmltable('/rows/row' PASSING xmlparse(DOCUMENT '<rows><row><a>10</a></row></rows>') COLUMNS rn FOR ORDINALITY, a int PATH 'a') AS x","expect":"ok","ref":"functions-xml","note":"xmltable with alias and column references"}
{"id":"xmla0158","category":"xml","sql":"SELECT xmlparse(DOCUMENT '<r xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:nil=\"true\"/>') IS DOCUMENT","expect":"ok","ref":"functions-xml","note":"IS DOCUMENT with namespace-aware document"}
{"id":"xmla0159","category":"xml","sql":"SELECT xmlelement(NAME foo, xmlattributes('v1' AS a1, 'v2' AS a2, 'v3' AS a3), xmlelement(NAME bar, xmlattributes('x' AS bx), 'inner'))","expect":"ok","ref":"functions-xml","note":"deeply nested xmlelement with multiple attributes"}
{"id":"xmla0160","category":"xml","sql":"SELECT xmlagg(xmlelement(NAME r, id)) OVER () FROM s.t LIMIT 1","expect":"ok","ref":"functions-xml","note":"xmlagg with empty OVER clause (window aggregate)"}
{"id":"xmla0161","category":"xml","sql":"SELECT xmlelement(NAME root, VARIADIC ARRAY['a','b','c'])","expect":"error","ref":"functions-xml","note":"xmlelement with VARIADIC - not valid syntax"}
{"id":"xmla0162","category":"xml","sql":"SELECT xmlparse(DOCUMENT '<root>' || '</root>')","expect":"ok","ref":"functions-xml","note":"xmlparse with concatenated string argument"}
{"id":"xmla0163","category":"xml","sql":"SELECT xmlserialize(CONTENT xmlconcat(xmlelement(NAME a), xmlelement(NAME b)) AS text)","expect":"ok","ref":"functions-xml","note":"xmlserialize CONTENT of xmlconcat"}
{"id":"xmla0164","category":"xml","sql":"SELECT xmlelement(NAME foo, xmlattributes(CURRENT_DATE AS today))","expect":"ok","ref":"functions-xml","note":"xmlattributes with CURRENT_DATE expression"}
{"id":"xmla0165","category":"xml","sql":"SELECT xmlelement(NAME foo, xmlattributes(42::text AS n))","expect":"ok","ref":"functions-xml","note":"xmlattributes with cast expression"}
{"id":"xmla0166","category":"xml","sql":"SELECT xmlelement(NAME foo, xmlattributes(s.f(1) AS result))","expect":"ok","ref":"functions-xml","note":"xmlattributes with function call - needs explicit alias"}
{"id":"xmla0167","category":"xml","sql":"SELECT xpath('/root', xmlparse(DOCUMENT '<root/>'), ARRAY[ARRAY['a','http://a.com'],ARRAY['b','http://b.com']])","expect":"ok","ref":"functions-xml","note":"xpath with multiple namespace mappings"}
{"id":"xmla0168","category":"xml","sql":"SELECT * FROM xmltable('/rows/row' PASSING xmlparse(DOCUMENT '<rows><row><v>hello</v></row></rows>') COLUMNS v text PATH 'v', vx xml PATH 'v')","expect":"ok","ref":"functions-xml","note":"xmltable with text and xml typed columns"}
{"id":"xmla0169","category":"xml","sql":"SELECT xmlelement(NAME root, xmlforest(name AS n, val AS v), xmlcomment('end')) FROM s.t LIMIT 1","expect":"ok","ref":"functions-xml","note":"xmlelement mixing xmlforest and xmlcomment children"}
{"id":"xmla0170","category":"xml","sql":"SELECT xmlserialize(DOCUMENT xmlparse(DOCUMENT '<root><child>text &amp; more</child></root>') AS text)","expect":"ok","ref":"functions-xml","note":"xmlserialize round-trip with entity references"}
