{"id":"txpb0153","category":"text-pattern","sql":"SELECT 'HELLO' !~* '^h'","expect":"ok","ref":"functions-matching","note":"POSIX !~* case-insensitive not match"}
{"id":"txpb0154","category":"text-pattern","sql":"SELECT position('lo' in 'hello')","expect":"ok","ref":"functions-matching","note":"position lowercase in keyword"}
{"id":"txpb0155","category":"text-pattern","sql":"SELECT position('hello' IN '')","expect":"ok","ref":"functions-matching","note":"position of string in empty returns 0"}
{"id":"txpb0156","category":"text-pattern","sql":"SELECT strpos('hello world hello', 'hello')","expect":"ok","ref":"functions-matching","note":"strpos finds first occurrence"}
{"id":"txpb0157","category":"text-pattern","sql":"SELECT overlay('Txxxxxt' PLACING 'BBB' FROM 2 FOR 4)","expect":"ok","ref":"functions-matching","note":"overlay classic example from docs"}
{"id":"txpb0158","category":"text-pattern","sql":"SELECT trim(BOTH '\"' FROM '\"hello\"')","expect":"ok","ref":"functions-matching","note":"trim double-quote chars from string"}
{"id":"txpb0159","category":"text-pattern","sql":"SELECT trim(' hello ')","expect":"ok","ref":"functions-matching","note":"trim function default both sides"}
{"id":"txpb0160","category":"text-pattern","sql":"SELECT ltrim('   ')","expect":"ok","ref":"functions-matching","note":"ltrim all spaces"}
{"id":"txpb0161","category":"text-pattern","sql":"SELECT rtrim('hello   ')","expect":"ok","ref":"functions-matching","note":"rtrim trailing spaces"}
{"id":"txpb0162","category":"text-pattern","sql":"SELECT 'hello' LIKE '%' OR 'world' LIKE 'w%'","expect":"ok","ref":"functions-matching","note":"LIKE combined with OR"}
{"id":"txpb0163","category":"text-pattern","sql":"SELECT CASE WHEN 'hello' LIKE 'h%' THEN 1 ELSE 0 END","expect":"ok","ref":"functions-matching","note":"LIKE inside CASE expression"}
{"id":"txpb0164","category":"text-pattern","sql":"SELECT name FROM s.t WHERE name SIMILAR TO '[A-Z]%'","expect":"ok","ref":"functions-matching","note":"SIMILAR TO in WHERE on table column"}
{"id":"txpb0165","category":"text-pattern","sql":"SELECT name FROM s.t WHERE name ~ '^[a-z]' AND name LIKE '%e%'","expect":"ok","ref":"functions-matching","note":"POSIX ~ combined with LIKE in WHERE"}
{"id":"txpb0166","category":"text-pattern","sql":"SELECT 'hello' LIKE 'h%' AND 'world' ~ 'w.*d'","expect":"ok","ref":"functions-matching","note":"LIKE and POSIX ~ combined with AND"}
{"id":"txpb0167","category":"text-pattern","sql":"SELECT regexp_match('hello', '[invalid')","expect":"error","ref":"functions-matching","note":"regexp_match with invalid regex pattern is error"}
{"id":"txpb0168","category":"text-pattern","sql":"SELECT 'hello' ~ '[invalid'","expect":"error","ref":"functions-matching","note":"POSIX ~ with invalid regex is error"}
{"id":"txpb0169","category":"text-pattern","sql":"SELECT substring('hello world' SIMILAR '%#\"(\\w+)#\"%' ESCAPE '#')","expect":"ok","ref":"functions-matching","note":"substring SIMILAR ESCAPE extracts word"}
{"id":"txpb0170","category":"text-pattern","sql":"SELECT regexp_replace('hello world', '(\\w+) (\\w+)', '\\2 \\1')","expect":"ok","ref":"functions-matching","note":"regexp_replace swap two words via backreferences"}
