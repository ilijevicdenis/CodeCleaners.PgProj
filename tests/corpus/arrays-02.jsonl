{"id":"arrb0163","category":"arrays","sql":"SELECT (ARRAY[10,20,30,40,50])[2:4]","expect":"ok","ref":"arrays","note":"slice with parens around constructor"}
{"id":"arrb0164","category":"arrays","sql":"SELECT a[1:2] FROM (SELECT ARRAY[10,20,30] AS a) sub","expect":"ok","ref":"arrays","note":"slice from subquery derived column"}
{"id":"arrb0165","category":"arrays","sql":"SELECT array_cat(ARRAY[]::int[], ARRAY[1,2,3])","expect":"ok","ref":"arrays","note":"array_cat with empty left arg"}
{"id":"arrb0166","category":"arrays","sql":"SELECT array_cat(ARRAY[1,2,3], ARRAY[]::int[])","expect":"ok","ref":"arrays","note":"array_cat with empty right arg"}
{"id":"arrb0167","category":"arrays","sql":"SELECT ARRAY[1,2,3] || ARRAY[]::int[]","expect":"ok","ref":"arrays","note":"|| concat with empty array"}
{"id":"arrb0168","category":"arrays","sql":"SELECT array_agg(x ORDER BY x DESC) FROM unnest(ARRAY[3,1,2]) AS u(x)","expect":"ok","ref":"arrays","note":"array_agg with ORDER BY DESC over unnest"}
