  "Functions": [
    {
      "Schema": "afd",
      "Name": "accumulate",
      "Signature": "afd.accumulate(bigint, integer[])",
      "Body": "CREATE FUNCTION afd.accumulate(INOUT running bigint,VARIADIC vals integer[]) LANGUAGE plpgsql IMMUTABLE AS $$\nDECLARE\n    v integer;\nBEGIN\n    FOREACH v IN ARRAY vals LOOP\n        running := running \u002B v;\n    END LOOP;\nEND;\n$$",
      "ArgTypes": "bigint, integer[]"
    },
    {
      "Schema": "afd",
      "Name": "active_customers",
      "Signature": "afd.active_customers()",
      "Body": "CREATE FUNCTION afd.active_customers() RETURNS SETOF afd.customers LANGUAGE sql STABLE SECURITY DEFINER AS $$\n    SELECT * FROM afd.customers WHERE is_active\n$$",
      "ArgTypes": ""
    },
    {
      "Schema": "afd",
      "Name": "add",
      "Signature": "afd.add(integer, integer)",
      "Body": "CREATE FUNCTION afd.add(a integer,b integer DEFAULT 0) RETURNS integer LANGUAGE sql IMMUTABLE STRICT PARALLEL SAFE RETURN a\u002Bb",
      "ArgTypes": "integer, integer"
    },
    {
      "Schema": "afd",
      "Name": "customer_stats",
      "Signature": "afd.customer_stats(numeric)",
      "Body": "CREATE FUNCTION afd.customer_stats(min_score numeric DEFAULT 0) RETURNS TABLE(status afd.mood,customer_count bigint,avg_score numeric) LANGUAGE plpgsql STABLE AS $$\nBEGIN\n    RETURN QUERY\n        SELECT c.status, count(*), avg(c.score)\n        FROM afd.customers c\n        WHERE c.score \u003E= min_score\n        GROUP BY c.status;\nEND;\n$$",
      "ArgTypes": "numeric"
    },
    {
      "Schema": "afd",
      "Name": "log_ddl",
      "Signature": "afd.log_ddl()",
      "Body": "CREATE FUNCTION afd.log_ddl() RETURNS event_trigger LANGUAGE plpgsql AS $$\nBEGIN\n    RAISE NOTICE \u0027DDL command % executed\u0027, tg_tag;\nEND;\n$$",
      "ArgTypes": ""
    },
    {
      "Schema": "afd",
      "Name": "mood_eq",
      "Signature": "afd.mood_eq(afd.mood, afd.mood)",
      "Body": "CREATE FUNCTION afd.mood_eq(a afd.mood,b afd.mood) RETURNS boolean LANGUAGE sql IMMUTABLE STRICT AS $$\n    SELECT a = b\n$$",
      "ArgTypes": "afd.mood, afd.mood"
    },
    {
      "Schema": "afd",
      "Name": "mood_to_int",
      "Signature": "afd.mood_to_int(afd.mood)",
      "Body": "CREATE FUNCTION afd.mood_to_int(m afd.mood) RETURNS integer LANGUAGE sql IMMUTABLE STRICT AS $$\n    SELECT CASE m WHEN \u0027sad\u0027 THEN -1 WHEN \u0027ok\u0027 THEN 0 WHEN \u0027happy\u0027 THEN 1 END\n$$",
      "ArgTypes": "afd.mood"
    },
    {
      "Schema": "afd",
      "Name": "split_name",
      "Signature": "afd.split_name(text, text, text)",
      "Body": "CREATE FUNCTION afd.split_name(IN full_name text,OUT first_name text,OUT last_name text) LANGUAGE sql IMMUTABLE AS $$\n    SELECT split_part(full_name, \u0027 \u0027, 1),\n           split_part(full_name, \u0027 \u0027, 2)\n$$",
      "ArgTypes": "text, text, text"
    },
    {
      "Schema": "afd",
      "Name": "touch_updated_at",
      "Signature": "afd.touch_updated_at()",
      "Body": "CREATE FUNCTION afd.touch_updated_at() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n    NEW.created_at := now();\n    RETURN NEW;\nEND;\n$$",
      "ArgTypes": ""
    },
    {
      "Schema": "afd",
      "Name": "archive_customer",
      "Signature": "afd.archive_customer(integer, bigint, boolean)",
      "Body": "CREATE PROCEDURE afd.archive_customer(IN p_tenant integer,IN p_id bigint,INOUT moved boolean DEFAULT false) LANGUAGE plpgsql AS $$\nBEGIN\n    INSERT INTO afd.customers_archive\n    SELECT now(), c.*\n    FROM afd.customers c\n    WHERE c.tenant_id = p_tenant AND c.id = p_id;\n\n    DELETE FROM afd.customers c\n    WHERE c.tenant_id = p_tenant AND c.id = p_id;\n\n    moved := FOUND;\nEND;\n$$",
      "ArgTypes": "integer, bigint, boolean"
    }
  ],
