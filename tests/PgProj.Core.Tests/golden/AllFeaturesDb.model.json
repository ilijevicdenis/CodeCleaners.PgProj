  "Views": [
    {
      "Schema": "afd",
      "Name": "active_customers_v",
      "Body": "SELECT tenant_id,id,email,full_name,is_active,status FROM afd.customers WHERE is_active",
      "IsMaterialized": false
    },
    {
      "Schema": "afd",
      "Name": "customer_orders",
      "Body": "SELECT c.tenant_id,c.id AS customer_id,c.email,count(o.id) AS order_count,coalesce(sum(o.total_cents),0) AS total_cents FROM afd.customers c LEFT JOIN afd.orders o ON o.tenant_id=c.tenant_id AND o.customer_id=c.id GROUP BY c.tenant_id,c.id,c.email",
      "IsMaterialized": false
    },
    {
      "Schema": "reporting",
      "Name": "customer_mv",
      "Body": "SELECT status,count(*) AS n,avg(score) AS avg_score FROM afd.customers GROUP BY status",
      "IsMaterialized": true
    }
  ],
