<Project DefaultTargets="Build">
  <Import Project="..\..\src\PgProj.Sdk\Sdk\Sdk.props" />
  <PropertyGroup>
    <Name>SampleDb</Name>
    <DefaultSchema>app</DefaultSchema>
    <TargetPostgresVersion>16</TargetPostgresVersion>
  </PropertyGroup>
  <!-- No <Build Include="**/*.sql" /> needed — the SDK auto-includes all *.sql files.
       Set <EnableDefaultSqlItems>false</EnableDefaultSqlItems> to opt out. -->
  <Import Project="..\..\src\PgProj.Sdk\Sdk\Sdk.targets" />
</Project>
